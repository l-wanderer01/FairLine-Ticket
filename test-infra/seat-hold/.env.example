# Public local-test values only. Never use real/deployed credentials here.
# Run Compose from this directory so the root MSA .env is not loaded.
SEAT_TEST_DB_USER=seat_test
SEAT_TEST_DB_PASSWORD=seat-test-only-db-password
SEAT_TEST_JWT_SECRET=seat-test-only-jwt-secret-at-least-32-bytes
SEAT_TEST_INTERNAL_API_TOKEN=seat-test-only-internal-token

SEAT_TEST_POSTGRES_PORT=15432
SEAT_TEST_REDIS_PORT=16379
SEAT_TEST_TICKETING_PORT=28084
